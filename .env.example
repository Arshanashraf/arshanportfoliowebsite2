# PostgreSQL connection string. Keep this server-only.
DATABASE_URL=postgresql://user:password@localhost:5432/arshan_portfolio

# At least 32 random bytes. Keys anonymous rate-limit identifiers, so sign-in and the
# contact form refuse every request without it.
APP_SECRET=replace-with-at-least-32-random-bytes

# Only turn this on when the database requires TLS and its connection string does not
# already say so. Hosted providers normally append ?sslmode=require, which is enough on
# its own. Setting this to true against a local server that has no TLS makes every query
# fail with "The server does not support SSL connections".
DB_SSL=false

# Optional. Used for canonical URLs, the sitemap, and robots.txt. Falls back to Vercel's
# production URL on a deployment, then to the request host.
NEXT_PUBLIC_SITE_URL=
